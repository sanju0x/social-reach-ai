{
  "name": "social-reach-ai",
  "version": "0.1.0",
  "description": "Public social profile checks and evidence-aware AI account advice",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.js",
